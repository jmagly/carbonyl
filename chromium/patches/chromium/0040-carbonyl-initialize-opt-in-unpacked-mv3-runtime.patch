+    RegisterNonNetworkWorkerMainResourceURLLoaderFactories(
+        content::BrowserContext* browser_context,
+        const std::optional<url::Origin>& request_initiator,
+        network::mojom::RequestDestination request_destination,
+        NonNetworkURLLoaderFactoryMap* factories) {
+  carbonyl::RegisterExtensionWorkerFactories(browser_context,
+                                             request_initiator, factories);
+}
+
+void HeadlessContentBrowserClient::
+    RegisterNonNetworkServiceWorkerUpdateURLLoaderFactories(
+        content::BrowserContext* browser_context,
+        NonNetworkURLLoaderFactoryMap* factories) {
+  carbonyl::RegisterExtensionServiceWorkerUpdateFactories(browser_context,
+                                                          factories);
+}
+
+void HeadlessContentBrowserClient::
+    RegisterNonNetworkSubresourceURLLoaderFactories(
+        int render_process_id,
+        int render_frame_id,
+        const std::optional<url::Origin>& request_initiator_origin,
+        NonNetworkURLLoaderFactoryMap* factories) {
+  carbonyl::RegisterExtensionSubresourceFactories(
+      render_process_id, render_frame_id, factories);
+}
+
+void HeadlessContentBrowserClient::OverrideURLLoaderFactoryParams(
+    content::BrowserContext* browser_context,
+    const url::Origin& origin,
+    bool is_for_isolated_world,
+    bool is_for_service_worker,
+    network::mojom::URLLoaderFactoryParams* factory_params) {
+  carbonyl::OverrideExtensionURLLoaderFactoryParams(
+      browser_context, origin, is_for_isolated_world, is_for_service_worker,
+      factory_params);
 }
 
