+      service_worker_version_info, associated_registry);
+}
+
+bool HeadlessContentBrowserClient::IsHandledURL(const GURL& url) {
+  return ContentBrowserClient::IsHandledURL(url) ||
+         carbonyl::IsExtensionHandledURL(url);
+}
+
+std::optional<GURL> HeadlessContentBrowserClient::GetEffectiveURL(
+    content::BrowserContext* browser_context,
+    const GURL& url) {
+  return carbonyl::GetExtensionEffectiveURL(browser_context, url);
+}
+
+bool HeadlessContentBrowserClient::ShouldUseProcessPerSite(
+    content::BrowserContext* browser_context,
+    const GURL& site_url) {
+  return carbonyl::ShouldUseExtensionProcessPerSite(browser_context, site_url);
+}
+
+bool HeadlessContentBrowserClient::ShouldUseSpareRenderProcessHost(
+    content::BrowserContext* browser_context,
+    const GURL& site_url,
+    std::optional<SpareProcessRefusedByEmbedderReason>& refused_reason) {
+  if (!carbonyl::ShouldUseSpareProcessForExtensionURL(site_url)) {
+    refused_reason = SpareProcessRefusedByEmbedderReason::ExtensionProcess;
+    return false;
+  }
+  return true;
+}
+
+bool HeadlessContentBrowserClient::DoesSiteRequireDedicatedProcess(
+    content::BrowserContext* browser_context,
+    const GURL& effective_site_url) {
+  return carbonyl::DoesExtensionSiteRequireDedicatedProcess(
+      browser_context, effective_site_url);
+}
+
+bool HeadlessContentBrowserClient::CanCommitURL(
+    content::RenderProcessHost* process_host,
+    const GURL& url) {
+  return carbonyl::CanCommitExtensionURL(process_host, url);
+}
