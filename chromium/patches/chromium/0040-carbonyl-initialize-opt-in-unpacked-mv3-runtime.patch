+void HeadlessContentBrowserClient::CreateThrottlesForNavigation(
+    content::NavigationThrottleRegistry& registry) {
+  carbonyl::AddExtensionNavigationThrottle(registry);
+}
+
+bool HeadlessContentBrowserClient::HasWebRequestAPIProxy(
+    content::BrowserContext* browser_context) {
+  return carbonyl::HasExtensionWebRequestAPIProxy(browser_context);
+}
+
+void HeadlessContentBrowserClient::WillCreateURLLoaderFactory(
+    content::BrowserContext* browser_context,
+    content::RenderFrameHost* frame,
+    int render_process_id,
+    URLLoaderFactoryType type,
+    const url::Origin& request_initiator,
+    const net::IsolationInfo&,
+    std::optional<int64_t> navigation_id,
+    ukm::SourceIdObj ukm_source_id,
+    network::URLLoaderFactoryBuilder& factory_builder,
+    mojo::PendingRemote<network::mojom::TrustedURLLoaderHeaderClient>*
+        header_client,
+    bool* bypass_redirect_checks,
+    bool*,
+    network::mojom::URLLoaderFactoryOverridePtr*,
+    scoped_refptr<base::SequencedTaskRunner> navigation_response_task_runner) {
+  carbonyl::MaybeProxyExtensionURLLoaderFactory(
+      browser_context, frame, render_process_id, type, request_initiator,
+      std::move(navigation_id), ukm_source_id, factory_builder, header_client,
+      bypass_redirect_checks, std::move(navigation_response_task_runner));
+}
+
+bool HeadlessContentBrowserClient::IsSuitableHost(
+    content::RenderProcessHost* process_host,
+    const GURL& site_url) {
+  return carbonyl::IsSuitableExtensionProcessHost(process_host, site_url);
+}
+
+void HeadlessContentBrowserClient::SiteInstanceGotProcessAndSite(
+    content::SiteInstance* site_instance) {
+  carbonyl::ExtensionSiteInstanceGotProcessAndSite(site_instance);
+}
