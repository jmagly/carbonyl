 #include "content/public/browser/browser_thread.h"
@@ -64,8 +68,10 @@ HeadlessBrowserContextImpl::HeadlessBrowserContextImpl(
           std::make_unique<HeadlessPermissionManager>()),
       hints_delegate_(
           std::make_unique<HeadlessClientHintsControllerDelegate>()) {
-  BrowserContextDependencyManager::GetInstance()->MarkBrowserContextLive(this);
   InitWhileIOAllowed();
+  extension_prefs_ = carbonyl::CreateExtensionProfilePrefs(this);
+  carbonyl::RegisterExtensionContext(this);
+  BrowserContextDependencyManager::GetInstance()->MarkBrowserContextLive(this);
   simple_factory_key_ =
       std::make_unique<SimpleFactoryKey>(GetPath(), IsOffTheRecord());
   SimpleKeyMap::GetInstance()->Associate(this, simple_factory_key_.get());
@@ -82,6 +88,12 @@ HeadlessBrowserContextImpl::HeadlessBrowserContextImpl(
   // Ensure the delegate is initialized early to give it time to load its
   // persistence.
   GetOriginTrialsControllerDelegate();
+
+  std::string extension_error;
+  if (!carbonyl::InitializeExtensionContext(this, &extension_error)) {
+    LOG(ERROR) << "CARBONYL_EXTENSION_ERROR " << extension_error;
+    browser_->ShutdownWithExitCode(EXIT_FAILURE);
+  }
 }
 
 HeadlessBrowserContextImpl::~HeadlessBrowserContextImpl() {
@@ -105,6 +117,8 @@ HeadlessBrowserContextImpl::~HeadlessBrowserContextImpl() {
 
   BrowserContextDependencyManager::GetInstance()->DestroyBrowserContextServices(
       this);
+  carbonyl::UnregisterExtensionContext(this);
+  extension_prefs_->CommitPendingWrite();
 }
 
