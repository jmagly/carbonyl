+namespace {
+
+constexpr char kStorageFlushTokenSwitch[] =
+    "carbonyl-storage-flush-token";
+
+bool IsValidStorageFlushToken(std::string_view token) {
+  if (token.size() != 32) {
+    return false;
+  }
+  for (char character : token) {
+    if (!((character >= '0' && character <= '9') ||
+          (character >= 'a' && character <= 'f'))) {
+      return false;
+    }
+  }
+  return true;
+}
