 #endif
@@ -180,12 +200,70 @@ HeadlessBrowserImpl::BrowserMainThread() const {
 void HeadlessBrowserImpl::Shutdown() {
   DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
 
+  if (did_shutdown_) {
+    return;
+  }
   did_shutdown_ = true;
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("user-data-dir")) {
+    FinishShutdown(std::nullopt);
+    return;
+  }
+
+  std::vector<content::BrowserContext*> contexts;
+  for (HeadlessBrowserContext* context : GetAllBrowserContexts()) {
+    // Close every page on the UI sequence before asking its loaded storage
+    // partitions to flush. Copy the list because Close() unregisters entries.
+    for (HeadlessWebContents* web_contents : context->GetAllWebContents()) {
+      web_contents->Close();
+    }
+    contexts.push_back(HeadlessBrowserContextImpl::From(context));
+  }
+
+  storage_flush_coordinator_ =
+      std::make_unique<carbonyl::StorageFlushCoordinator>(base::Seconds(10));
+  storage_flush_coordinator_->Start(
+      contexts,
+      base::BindOnce(&HeadlessBrowserImpl::OnStorageFlushComplete,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void HeadlessBrowserImpl::OnStorageFlushComplete(
+    carbonyl::StorageFlushSummary flush_summary) {
+  FinishShutdown(flush_summary);
+}
+
+void HeadlessBrowserImpl::FinishShutdown(
+    std::optional<carbonyl::StorageFlushSummary> flush_summary) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+  if (flush_summary) {
+    CHECK(storage_flush_coordinator_);
+    CHECK(storage_flush_coordinator_->state_machine().BeginDestroy());
+  }
   weak_ptr_factory_.InvalidateWeakPtrs();
   // Make sure GetAllBrowserContexts is sane if called after this point.
   auto tmp = std::move(browser_contexts_);
   tmp.clear();
   system_request_context_manager_.reset();
+  if (flush_summary) {
+    CHECK(storage_flush_coordinator_->state_machine().MarkStopped());
+    flush_summary = storage_flush_coordinator_->state_machine().summary();
+    const std::string storage_flush_token =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            kStorageFlushTokenSwitch);
+    std::cerr << "CARBONYL_STORAGE_FLUSH_RESULT={\"schema_version\":1,"
+              << "\"state\":\"" << carbonyl::ToString(flush_summary->state)
+              << "\",\"result\":\""
+              << carbonyl::ToString(flush_summary->result)
+              << "\",\"partitions\":" << flush_summary->partitions
+              << ",\"acknowledged\":" << flush_summary->acknowledged
+              << ",\"token\":\""
+              << (IsValidStorageFlushToken(storage_flush_token)
+                      ? storage_flush_token
+                      : std::string())
+              << "\"}"
+              << std::endl;
+  }
   // We might have posted task during shutdown, let these run
   // before quitting the message loop. See ~HeadlessWebContentsImpl
   // for additional context.
@@ -195,6 +273,15 @@ void HeadlessBrowserImpl::Shutdown() {
   }
 }
 
+bool HeadlessBrowserImpl::RejectIfDraining(std::string_view operation) const {
+  if (CanAcceptPageWork()) {
+    return false;
+  }
+  LOG(ERROR) << "CARBONYL_LIFECYCLE_ERROR code=draining operation="
+             << operation;
+  return true;
+}
